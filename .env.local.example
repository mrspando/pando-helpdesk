NEXT_PUBLIC_SUPABASE_URL=
# Clave "publishable" (sb_publishable_...) del proyecto Supabase — NUNCA la
# "secret" (sb_secret_...), que debe quedarse solo en el servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=tu_password_aqui

# Clave "service_role" (Project Settings → API) — bypassa RLS por completo.
# Solo la usa lib/supabase/admin.ts para procesos de servidor privilegiados
# (hoy, el cron de ingesta de correo). Nunca se expone al navegador, ver
# PERMISOS.md → "BACKEND".
SUPABASE_SERVICE_ROLE_KEY=

# Protege app/api/cron/ingest-mail de invocaciones externas. Genera un
# valor aleatorio largo y pégalo también en las env vars de Vercel: Vercel
# envía esta misma variable como header Authorization en cada invocación
# de cron (ver vercel.json) solo si existe con este nombre en el proyecto.
CRON_SECRET=

# Envío de correo real desde "Responder" (Microsoft Graph, permiso de
# aplicación Mail.Send). Registro de app SEPARADO del usado para el
# login SSO (pando-helpdesk-auth) — ver CONTEXT.md, sección
# "Auth con Entra ID". Cada respuesta se envía "como" el email de quien
# esté conectado (no un buzón fijo) — it@pando.es es solo de recepción.
# El admin de Exchange debe restringir este registro, vía
# New-ApplicationAccessPolicy, a un grupo de seguridad con los buzones
# de los agentes (hoy solo mramirez@pando.es, ampliable si se suman
# compañeros), no a it@pando.es.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Ingesta de correo entrante desde it@pando.es (todavía sin implementar
# en código, ver CONTEXT.md → "Flujo de correo"). Registro de app
# SEPARADO del de envío de arriba (menor radio de exposición: si se
# filtra una credencial, la de leer no puede enviar y viceversa),
# permiso de aplicación Mail.ReadWrite (ReadWrite y no solo Read: hace
# falta poder marcar los correos como procesados para no reprocesarlos
# en cada pasada del cron), restringido por el admin de Exchange
# únicamente al buzón it@pando.es. Mismo tenant que el bloque de
# arriba — GRAPH_TENANT_ID no se repite.
GRAPH_INGEST_CLIENT_ID=
GRAPH_INGEST_CLIENT_SECRET=
GRAPH_INGEST_MAILBOX=it@pando.es